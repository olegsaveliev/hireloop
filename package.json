    "typecheck": "tsc --noEmit",
    "test:budget": "tsx scripts/tests/test-budget-rules.ts",
    "test:job-spec": "tsx scripts/tests/test-job-spec.ts",
    "test:phase2": "tsx scripts/tests/test-phase2.ts",
    "test:phase3": "tsx scripts/tests/test-phase3.ts",
    "check:langfuse": "tsx scripts/langfuse/check.ts",
    "eval:fixtures": "tsx scripts/evals/build-fixtures.ts",
    "eval": "tsx scripts/evals/eval.ts",
    "setup:dashboards": "tsx scripts/langfuse/setup-dashboards.ts",
    "test:phase4": "tsx scripts/tests/test-phase4.ts",
    "test:phase5": "tsx scripts/tests/test-phase5.ts && tsx scripts/tests/test-step9.ts",
    "test:step9": "tsx scripts/tests/test-step9.ts",
    "test:inbound": "tsx scripts/tests/test-inbound.ts",
    "test:gmail-outreach": "tsx scripts/tests/test-gmail-outreach.ts",
    "test:gmail-client": "tsx scripts/tests/test-gmail-client.ts",
    "test:cv-upload": "tsx scripts/tests/test-cv-upload.ts",
