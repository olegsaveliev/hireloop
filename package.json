    "@googleapis/gmail": "^22.0.1",
    "@langfuse/client": "^5.13.0",
    "@langfuse/otel": "^5.13.0",
    "@langfuse/tracing": "^5.13.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "google-auth-library": "^11.1.0",
    "next": "16.3.8",
    "react": "19.2.8",
