# Copy this file to .env.local (cp .env.example .env.local). Never commit .env.local.
# Keys can also be added in the app: key icon in the left rail. A key saved in the app wins over this file.

# Local SQLite database file (later: a Postgres connection string)
DATABASE_URL="file:./prisma/dev.db"

# Anthropic (required): console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# Langfuse (optional, traces and scores): cloud.langfuse.com -> your project -> Settings -> API keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Google (needed from step 5, outreach): see docs/google-setup.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Your second Gmail that plays candidates and clients. The app may send to it and its + variants.
# Demo data addresses (test.inbox+12@example.com) become yours+12@... when you run npm run db:seed.
GOOGLE_TEST_INBOX=
# Optional, comma-separated: other addresses the app may send to. Everything else is refused.
GOOGLE_SEND_ALLOWLIST=
# Only if the app doesn't run on localhost:3000
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
